{% set workshop = workshops[workshopId] %}
{% set t = workshop[lang] %}

<!DOCTYPE html>
<html lang="{{ lang }}">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff">

<!-- SEO -->
{% if t.seo and t.seo.title %}
  <title>{{ t.seo.title }}</title>
{% else %}
  <title>{{ t.title }} | PURACERÂMICA</title>
{% endif %}

{% if t.seo and t.seo.description %}
  <meta
    name="description"
    content="{{ t.seo.description }}"
  >
{% endif %}

<!-- CANONICAL -->
{% if t.url %}
  <link
    rel="canonical"
    href="https://puraceramica.pt{{ t.url }}"
  >
{% endif %}

<!-- LANGUAGE ALTERNATES -->
{% if workshop.en and workshop.en.url %}
  <link
    rel="alternate"
    hreflang="en"
    href="https://puraceramica.pt{{ workshop.en.url }}"
  >
{% endif %}

{% if workshop.pt and workshop.pt.url %}
  <link
    rel="alternate"
    hreflang="pt"
    href="https://puraceramica.pt{{ workshop.pt.url }}"
  >
{% endif %}

{% if workshop.en and workshop.en.url %}
  <link
    rel="alternate"
    hreflang="x-default"
    href="https://puraceramica.pt{{ workshop.en.url }}"
  >
{% endif %}

<!-- OPEN GRAPH -->
<meta
  property="og:title"
  content="{% if t.seo and t.seo.title %}{{ t.seo.title }}{% else %}{{ t.title }} | PURACERÂMICA{% endif %}"
>

{% if t.seo and t.seo.description %}
  <meta
    property="og:description"
    content="{{ t.seo.description }}"
  >
{% endif %}

<meta property="og:type" content="website">

{% if t.url %}
  <meta
    property="og:url"
    content="https://puraceramica.pt{{ t.url }}"
  >
{% endif %}

{% if workshop.image %}
  <meta
    property="og:image"
    content="https://puraceramica.pt{{ workshop.image }}"
  >
{% endif %}

<!-- STRUCTURED DATA: WORKSHOP EVENTS -->
{% if workshop.dates and workshop.dates.length %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {% for session in workshop.dates %}
      {% set eventInstructor = instructors[session.instructor] %}
      {
        "@type": "Event",
        "name": {{ t.title | dump | safe }},
        "description": {{ t.seo.description | dump | safe }},
        "startDate": "{{ session.date }}T{{ session.start }}",
        "endDate": "{{ session.date }}T{{ session.end }}",
        "eventStatus": "https://schema.org/EventScheduled",
        "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",

        "location": {
          "@type": "Place",
          "name": {{ studio.location.name | dump | safe }},
          "address": {
            "@type": "PostalAddress",
            "streetAddress": {{ studio.location.streetAddress | dump | safe }},
            "postalCode": {{ studio.location.postalCode | dump | safe }},
            "addressLocality": {{ studio.location.city | dump | safe }},
            "addressCountry": {{ studio.location.country | dump | safe }}
          }
        },

        "image": [
          "{{ studio.url }}{{ workshop.image }}"
        ],

        "offers": {
  "@type": "Offer",
  "price": "{{ workshop.price }}",
  "priceCurrency": "{{ workshop.priceCurrency }}"{% if workshop.booking and workshop.booking.url %},
  "url": {{ workshop.booking.url | dump | safe }}{% endif %}
},

        "organizer": {
          "@type": "Organization",
          "name": {{ studio.name | dump | safe }},
          "url": {{ studio.url | dump | safe }}
        }{% if eventInstructor %},

        "performer": {
          "@type": "Person",
          "name": {{ eventInstructor.name | dump | safe }}
        }{% endif %}
      }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

  <link rel="icon" href="/assets/img/icons/LOGO_PC_WEBSITE copy.png" type="image/png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,500;12..96,600&family=Hanken+Grotesk:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/assets/css/styles.css?v=20260904-1">
  <link rel="stylesheet" href="/assets/css/workshop.css?v=20260904-2">
  <link
    rel="preload"
    as="image"
    href="/assets/img/icons/LOGO.png"
    fetchpriority="high"
  >

</head>

<body>

  {% if lang == "pt" %}
    {% include "header-pt.html" %}
  {% else %}
    {% include "header-en.html" %}
  {% endif %}

  <main>
<!-- WORKSHOP DETAIL -->
<div class="workshop-detail-container">

  <div class="workshop-detail-grid">

   <!-- IMAGE -->
{% if workshop.image %}
  <div class="workshop-images">
    <div class="workshop-main-image">
      <img
        src="{{ workshop.image }}"
        alt="{% if lang == 'pt' %}{{ workshop.ptImageAlt }}{% else %}{{ workshop.enImageAlt }}{% endif %}"
        width="900"
        height="600"
        loading="eager"
      >
    </div>
  </div>
{% endif %}

    <!-- INFO + BOOKING -->
    <div class="workshop-info-panel">

      <span class="page-tag">{{ t.pageTag }}</span>

      <h1>{{ t.title }}</h1>

      <p class="workshop-intro">
        {{ t.intro }}
        <br>
        <em>{{ t.languageNote }}</em>
      </p>

      <!-- QUICK FACTS -->
      <div class="workshop-quick-facts">

        <div class="workshop-quick-fact">
          <span class="workshop-quick-label">
            {% if lang == "pt" %}Preço{% else %}Price{% endif %}
          </span>
{% if workshop.cohorts and workshop.pricePerSession %}
  <strong>
    €{{ workshop.pricePerSession | money }}
    {% if lang == "pt" %}/ sessão{% else %}/ session{% endif %}
    <small class="workshop-price-total">
      €{{ workshop.price }}
      {% if lang == "pt" %}no total{% else %}total{% endif %}
    </small>
  </strong>
{% else %}
  <strong
    id="workshop-price"
    data-base-price="{{ workshop.price }}"
  >
    €{{ workshop.price }}
    {% if workshop.priceUnit == "for-two" %}
      {% if lang == "pt" %}
        para 2 pessoas
      {% else %}
        for 2 people
      {% endif %}
    {% endif %}
  </strong>
{% endif %}   </div>

        <div class="workshop-quick-fact">
          <span class="workshop-quick-label">
            {% if lang == "pt" %}Duração{% else %}Duration{% endif %}
          </span>
<strong>
  {% if workshop.durationMinutes %}
    {{ workshop.durationMinutes / 60 }} h
  {% elif workshop.totalDurationMinutes %}
    {{ workshop.totalDurationMinutes / 60 }} h total
  {% endif %}
</strong>        </div>

        <div class="workshop-quick-fact">
          <span class="workshop-quick-label">
            {% if lang == "pt" %}Nível{% else %}Level{% endif %}
          </span>
          <strong>{{ t.levelLabel }}</strong>
        </div>

        <div class="workshop-quick-fact">
          <span class="workshop-quick-label">
            {% if lang == "pt" %}Idioma{% else %}Language{% endif %}
          </span>
          <strong>{{ t.languageLabel }}</strong>
        </div>

      </div>


      <!-- UPCOMING DATES -->
<!-- UPCOMING DATES / COURSE COHORTS -->

{% if workshop.cohorts %}

  <div class="workshop-booking-section workshop-cohorts-section">

    <div class="workshop-booking-heading">
      {% if lang == "pt" %}
        Escolha a sua turma
      {% else %}
        Choose your course start
      {% endif %}
    </div>

<div class="workshop-cohorts{% if workshop.cohorts | length == 1 %} single-cohort{% endif %}">
      {% for cohort in workshop.cohorts %}

        <article class="workshop-cohort-card">

          <div class="workshop-cohort-header">

 <span class="workshop-cohort-label">
  {% if lang == "pt" %}
    Curso de {{ cohort.startDate | workshopMonthName("pt") }}
  {% else %}
    {{ cohort.startDate | workshopMonthName("en") }} course
  {% endif %}
</span>
            <p>
              {% if lang == "pt" %}
                Começa em
              {% else %}
                Starts
              {% endif %}
              <strong>{{ cohort.startDate | workshopDate(lang) }}</strong>
            </p>

          </div>

{% if cohort.sessions[0].label %}

  <!-- MULTI-SESSION SCHEDULE -->
  <div class="workshop-cohort-schedule">

    <span class="workshop-cohort-schedule-heading">
      {% if lang == "pt" %}
        Inclui {{ cohort.sessions | length }} sessões
      {% else %}
        Includes {{ cohort.sessions | length }} sessions
      {% endif %}
    </span>

    <div class="workshop-cohort-schedule-list">

      {% for session in cohort.sessions %}

        <div class="workshop-cohort-session">

          <div class="workshop-cohort-session-main">
            <strong>{{ session.label }}</strong>

            <span>
              {{ session.date | workshopDate(lang) }}
            </span>
          </div>

          <span class="workshop-cohort-session-time">
            {{ session.start }}–{{ session.end }}
          </span>

        </div>

      {% endfor %}

    </div>

  </div>

{% else %}

  <!-- REGULAR COHORT DATES -->
  <div class="dates-list">

    {% for session in cohort.sessions %}

      <div class="date-block available">

        <div class="date-content">

          <span class="date-text">
            {{ session.date | workshopDate(lang) }}
            &nbsp;
            {{ session.start }}–{{ session.end }}
          </span>

        </div>

      </div>

    {% endfor %}

  </div>

{% endif %}

          {% set cohortInstructor = instructors[cohort.instructor] %}

          {% if cohortInstructor %}
            <p class="workshop-cohort-instructor">
              {% if lang == "pt" %}
                com {{ cohortInstructor.name }}
              {% else %}
                with {{ cohortInstructor.name }}
              {% endif %}

              {% if cohort.language %}
                &nbsp;·&nbsp; {{ cohort.language }}
              {% endif %}
            </p>
          {% endif %}


<div class="workshop-cohort-price">

  {% if workshop.pricePerSession %}

    <strong>
      €{{ workshop.pricePerSession | money }}
      {% if lang == "pt" %}
        / sessão
      {% else %}
        / session
      {% endif %}
    </strong>

  {% else %}

    <strong>
      €{{ workshop.price }}
      {% if lang == "pt" %}
        no total
      {% else %}
        total
      {% endif %}
    </strong>

  {% endif %}


  <span>

    {{ workshop.sessionCount }}

    {% if lang == "pt" %}
      sessões
    {% else %}
      sessions
    {% endif %}


    {% if workshop.totalDurationMinutes %}
      &nbsp;·&nbsp;
      {{ workshop.totalDurationMinutes / 60 }} h

      {% if lang == "pt" %}
        no total
      {% else %}
        total
      {% endif %}
    {% endif %}


    {% if workshop.pricePerSession %}
      &nbsp;·&nbsp;
      €{{ workshop.price }}

      {% if lang == "pt" %}
        no total
      {% else %}
        total
      {% endif %}
    {% endif %}

  </span>

</div>



          </div>


          <a
            href="{{ cohort.booking.url }}"
            class="workshop-book-btn"
            target="_blank"
            rel="noopener noreferrer"
          >
           {% if lang == "pt" %}
  Reservar curso de {{ cohort.startDate | workshopMonthName("pt") }}
{% else %}
  Book {{ cohort.startDate | workshopMonthName("en") }} course
{% endif %}
          </a>

        </article>

      {% endfor %}

    </div>

    <p class="booking-note">
      {% if lang == "pt" %}
  Uma reserva inclui todas as {{ workshop.sessionCount }} sessões.
{% else %}
  One booking includes all {{ workshop.sessionCount }} sessions.
{% endif %}
    </p>

  </div>

{% else %}

{% set months = workshop.dates | workshopMonths(lang) %}

      <div class="workshop-booking-section">

        <div class="workshop-booking-heading">
          {% if lang == "pt" %}
            Próximas datas
          {% else %}
            Upcoming dates
          {% endif %}
        </div>

        <div class="month-switcher">

          <div class="month-tabs">
            {% for month in months %}
              <button
                type="button"
                class="month-tab{% if loop.first %} active{% endif %}"
                onclick="switchMonth('{{ month.key }}', this)"
              >
                {{ month.label }}
              </button>
            {% endfor %}
          </div>

          {% for month in months %}
            <div
              class="month-panel{% if loop.first %} active{% endif %}"
              id="month-{{ month.key }}"
            >

              <div class="dates-list">

                {% for session in month.sessions %}
                  <label class="date-block available">

                    <input
                      type="radio"
                      name="workshop-date"
                      value="{{ session.date }}"
                      data-time="{{ session.start }}"
                      data-end="{{ session.end }}"
                    >

                    <div class="date-content">

                      <span class="date-text">
                        {{ session.displayDate }}
                        &nbsp;
                        {{ session.start }}–{{ session.end }}
                      </span>

                      {% set sessionInstructor = instructors[session.instructor] %}

{% if sessionInstructor %}
  <span class="date-instructor">
    {% if lang == "pt" %}
      &nbsp;·&nbsp; com {{ sessionInstructor.name }}
    {% else %}
      &nbsp;·&nbsp; with {{ sessionInstructor.name }}
    {% endif %}

    {% if session.language %}
      &nbsp;·&nbsp; {{ session.language }}
    {% endif %}
  </span>
{% endif %}


                    </div>

                  </label>
                {% endfor %}

              </div>
            </div>
          {% endfor %}

        </div>


        <!-- NO UPCOMING DATES -->
        <div class="workshop-no-dates" hidden>
          {% if lang == "pt" %}
            <p>
              <strong>Novas datas em breve.</strong><br>
              Mais datas serão anunciadas em breve.
            </p>
          {% else %}
            <p>
              <strong>New dates coming soon.</strong><br>
              More workshop dates will be announced shortly.
            </p>
          {% endif %}
        </div>


        {% if workshop.booking and workshop.booking.url %}

 {% if not workshop.participants or not workshop.participants.fixed %}

  <!-- QUANTITY -->
  <div class="quantity-section">

    <label for="quantity">
      {% if lang == "pt" %}
        Número de participantes
      {% else %}
        Number of participants
      {% endif %}
    </label>

    <div class="quantity-selector">
      <button
        type="button"
        class="qty-btn"
        onclick="decrementQty()"
        aria-label="Decrease quantity"
      >−</button>

      <input
  type="text"
  id="quantity"
  value="{% if workshop.participants and workshop.participants.min %}{{ workshop.participants.min }}{% else %}1{% endif %}"
  data-min="{% if workshop.participants and workshop.participants.min %}{{ workshop.participants.min }}{% else %}1{% endif %}"
  data-max="{% if workshop.participants and workshop.participants.max %}{{ workshop.participants.max }}{% else %}10{% endif %}"
  readonly
  aria-label="Number of participants"
>

      <button
        type="button"
        class="qty-btn"
        onclick="incrementQty()"
        aria-label="Increase quantity"
      >+</button>
    </div>

  </div>

{% endif %}

{% if workshop.participants and workshop.participants.fixed %}
  <p class="workshop-fixed-participants">
    {% if lang == "pt" %}
      Esta reserva inclui exatamente {{ workshop.participants.max }} participantes.
    {% else %}
      This booking includes exactly {{ workshop.participants.max }} participants.
    {% endif %}
  </p>
{% endif %}

  <!-- BOOK -->
  <a
    href="{{ workshop.booking.url }}"
    class="workshop-book-btn"
    id="booking-btn"
    data-category="{{ workshop.booking.category }}"
    data-provider="{{ workshop.booking.provider }}"
    target="_blank"
    rel="noopener noreferrer"
  >
    {% if lang == "pt" %}
      Reservar agora
    {% else %}
      Book now
    {% endif %}
  </a>

  <p class="booking-note">
    {% if lang == "pt" %}
      A reserva é concluída na nossa página de reservas segura.
    {% else %}
      Booking is completed on our secure booking page.
    {% endif %}
  </p>

{% endif %}

      </div>

{% endif %}

    </div>

  </div>

</div>


<!-- ABOUT -->
{% if t.about %}
<section class="workshop-content-section workshop-about">
  <div class="workshop-content-inner">

    <div class="workshop-section-label">
      {% if lang == "pt" %}
        Sobre o workshop
      {% else %}
        About this workshop
      {% endif %}
    </div>

    <div class="workshop-about-text">
      {% for paragraph in t.about %}
        <p>{{ paragraph }}</p>
      {% endfor %}
    </div>

  </div>
</section>
{% endif %}


<!-- WHAT YOU CAN MAKE -->
{% if t.whatYouCanMake %}
<section class="workshop-content-section workshop-make">
  <div class="workshop-content-inner">

    <div class="workshop-section-label">
      {% if lang == "pt" %}
        O que pode criar
      {% else %}
        What you can make
      {% endif %}
    </div>

    <div class="workshop-make-content">

      <p class="workshop-make-intro">
        {{ t.whatYouCanMake.intro }}
      </p>

      <div class="workshop-make-grid">
        {% for example in t.whatYouCanMake.examples %}
          <div class="workshop-make-item">
            <span class="workshop-make-number">
              0{{ loop.index }}
            </span>

            <h3>{{ example.title }}</h3>
            <p>{{ example.text }}</p>
          </div>
        {% endfor %}
      </div>

      {% if t.whatYouCanMake.note %}
        <p class="workshop-make-note">
          {{ t.whatYouCanMake.note }}
        </p>
      {% endif %}

    </div>

  </div>
</section>
{% endif %}

 <!-- TECHNIQUES -->
{% if t.techniques %}
<section class="workshop-content-section workshop-techniques">
  <div class="workshop-content-inner">

    <div class="workshop-section-label">
      {% if lang == "pt" %}
        Técnicas que pode explorar
      {% else %}
        Techniques you can explore
      {% endif %}
    </div>

    <div class="workshop-techniques-content">

      {% if t.techniques.intro %}
        <p class="workshop-techniques-intro">
          {{ t.techniques.intro }}
        </p>
      {% endif %}

      <div class="workshop-techniques-list">

        {% for technique in t.techniques.items %}
          <article class="workshop-technique">

            <div class="workshop-technique-image">
              <img
                src="{{ technique.image }}"
                alt="{{ technique.imageAlt }}"
                loading="lazy"
              >
            </div>

            <div class="workshop-technique-text">

              <span class="workshop-technique-number">
                0{{ loop.index }}
              </span>

              <h3>{{ technique.title }}</h3>

              <p>{{ technique.text }}</p>

            </div>

          </article>
        {% endfor %}

      </div>

    </div>

  </div>
</section>
{% endif %}

<!-- WHAT'S INCLUDED -->
{% if t.included %}
<section class="workshop-content-section workshop-included">
  <div class="workshop-content-inner">

    <div class="workshop-section-label">
      {% if lang == "pt" %}
        O que está incluído
      {% else %}
        What's included
      {% endif %}
    </div>

    <div class="workshop-included-content">

      {% if t.included.intro %}
        <p class="workshop-included-intro">
          {{ t.included.intro }}
        </p>
      {% endif %}

      <div class="workshop-included-list">

        {% for item in t.included.items %}
          <div class="workshop-included-item">

            <span class="workshop-included-number">
              0{{ loop.index }}
            </span>

            <div>
              <h3>{{ item.title }}</h3>
              <p>{{ item.text }}</p>
            </div>

          </div>
        {% endfor %}

      </div>

    </div>

  </div>
</section>
{% endif %}

<!-- BEFORE YOU COME -->
{% if t.beforeYouCome %}
<section class="workshop-content-section workshop-before">
  <div class="workshop-content-inner">

    <div class="workshop-section-label">
      {% if lang == "pt" %}
        Antes de vir
      {% else %}
        Before you come
      {% endif %}
    </div>

    <div class="workshop-before-content">

      {% if t.beforeYouCome.intro %}
        <p class="workshop-before-intro">
          {{ t.beforeYouCome.intro }}
        </p>
      {% endif %}

      <div class="workshop-before-grid">

        {% for item in t.beforeYouCome.items %}
          <div class="workshop-before-item">
            <h3>{{ item.title }}</h3>
            <p>{{ item.text }}</p>
          </div>
        {% endfor %}

      </div>

    </div>

  </div>
</section>
{% endif %}

<!-- IMPORTANT NOTICE -->
{% if t.notice %}
<section class="workshop-content-section workshop-notice">
  <div class="workshop-content-inner">

    <div class="workshop-section-label">
      {% if lang == "pt" %}
        Informação importante
      {% else %}
        Important information
      {% endif %}
    </div>

    <div class="workshop-notice-content">
      <div class="workshop-notice-box">

        {% if t.notice.title %}
          <h3>{{ t.notice.title }}</h3>
        {% endif %}

        <p>{{ t.notice.text }}</p>

      </div>
    </div>

  </div>
</section>
{% endif %}

<!-- INSTRUCTORS -->
{% set workshopInstructorList = workshop.dates | workshopInstructors(instructors) %}

{% if workshopInstructorList.length %}
<section class="workshop-content-section workshop-instructors">
  <div class="workshop-content-inner">

    <div class="workshop-section-label">
      {% if lang == "pt" %}
        {% if workshopInstructorList.length == 1 %}
          O seu instrutor
        {% else %}
          Os seus instrutores
        {% endif %}
      {% else %}
        {% if workshopInstructorList.length == 1 %}
          Your instructor
        {% else %}
          Your instructors
        {% endif %}
      {% endif %}
    </div>

    <div class="workshop-instructors-content">

      <div class="workshop-instructors-grid">

        {% for instructor in workshopInstructorList %}
          <article class="workshop-instructor">

            <div class="workshop-instructor-heading">
              <span class="workshop-instructor-number">
                0{{ loop.index }}
              </span>

              <div>
                <h3>{{ instructor.name }}</h3>

                {% if instructor[lang] and instructor[lang].role %}
                  <p class="workshop-instructor-role">
                    {{ instructor[lang].role }}
                  </p>
                {% endif %}
              </div>
            </div>

          </article>
        {% endfor %}

      </div>

    </div>

  </div>
</section>
{% endif %}

<!-- RELATED WORKSHOPS -->
{% set relatedWorkshopList = workshops | relatedWorkshops(workshopId, 3) %}

{% if relatedWorkshopList.length %}
<section class="workshop-related">

  <div class="workshop-related-inner">

    <div class="workshop-related-header">

      <span class="workshop-section-label">
        {% if lang == "pt" %}
          Descubra mais
        {% else %}
          Explore more
        {% endif %}
      </span>

      <h2>
        {% if lang == "pt" %}
          Também poderá gostar
        {% else %}
          You might also like
        {% endif %}
      </h2>

    </div>


    <div class="workshop-related-grid">

      {% for relatedWorkshop in relatedWorkshopList %}

        {% set relatedText = relatedWorkshop[lang] %}

        {% if relatedText and relatedText.url %}

          <a
            href="{{ relatedText.url }}"
            class="workshop-related-card"
          >

            {% if relatedWorkshop.image %}
              <div class="workshop-related-image">
                <img
                  src="{{ relatedWorkshop.image }}"
                  alt="{% if lang == 'pt' %}{{ relatedWorkshop.ptImageAlt or relatedText.title }}{% else %}{{ relatedWorkshop.enImageAlt or relatedText.title }}{% endif %}"
                  loading="lazy"
                >
              </div>
            {% endif %}


            <div class="workshop-related-content">

              {% if relatedText.pageTag %}
                <span class="workshop-related-tag">
                  {{ relatedText.pageTag }}
                </span>
              {% endif %}

              <h3>{{ relatedText.title }}</h3>

              <div class="workshop-related-meta">

                {% if relatedWorkshop.durationMinutes %}
                  <span>
                    {{ relatedWorkshop.durationMinutes / 60 }} h
                  </span>
                {% endif %}

                {% if relatedWorkshop.price %}
                  <span>
                    €{{ relatedWorkshop.price }}
                  </span>
                {% endif %}

              </div>

              <span class="workshop-related-link">
                {% if lang == "pt" %}
                  Ver workshop →
                {% else %}
                  View workshop →
                {% endif %}
              </span>

            </div>

          </a>

        {% endif %}

      {% endfor %}

    </div>

  </div>

</section>
{% endif %}

  </main>

  {% if lang == "pt" %}
    {% include "footer-pt.html" %}
  {% else %}
    {% include "footer-en.html" %}
  {% endif %}

  <script src="/assets/js/main.js?v=20260904-1"></script>

</body>
</html>